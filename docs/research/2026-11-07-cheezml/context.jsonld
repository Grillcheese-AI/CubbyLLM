{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "cheez": "https://w3id.org/cheezml/core#",
    "cubby": "https://w3id.org/cheezml/cubby#",
    "mowm": "https://w3id.org/cheezml/mowm#",
    "cube": "https://w3id.org/cheezml/cubelang#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "time": "http://www.w3.org/2006/time#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "cheez:writtenBy": {"@type": "@id"},
    "cheez:encoder": {"@type": "@id"},
    "cheez:screen": {"@type": "@id"},
    "cheez:calibrationData": {"@type": "@id"},
    "cheez:deployment": {"@type": "@id"},
    "cheez:check": {"@type": "@id"},
    "cheez:outcome": {"@type": "@id"},
    "cheez:retirementReason": {"@type": "@id"},
    "cheez:threshold": {"@type": "@id"},
    "cheez:certifies": {"@type": "@id"},
    "cheez:option": {"@type": "@id"},
    "cheez:chosenOption": {"@type": "@id"},
    "cheez:hasResult": {"@type": "@id"},
    "cheez:isSatisfiedBy": {"@type": "@id"},
    "cheez:isViolatedBy": {"@type": "@id"},
    "cheez:template": {"@type": "@id"},
    "cheez:validTime": {"@type": "@id"},
    "cheez:thresholdValue": {"@type": "xsd:decimal"},
    "cheez:observedValue": {"@type": "xsd:decimal"},

    "cubby:dialogueAct": {"@type": "@id"},
    "cubby:decision": {"@type": "@id"},
    "cubby:proposer": {"@type": "@id"},
    "cubby:refusalReason": {"@type": "@id"},
    "cubby:conflictKind": {"@type": "@id"},
    "cubby:scope": {"@type": "@id"},
    "cubby:breakingCase": {"@type": "@id"},
    "cubby:region": {"@type": "@id"},
    "cubby:turnIndex": {"@type": "xsd:integer"},

    "mowm:worldId": {"@type": "xsd:integer"},
    "mowm:zDepth": {"@type": "xsd:integer"},
    "mowm:zMax": {"@type": "xsd:integer"},
    "mowm:worldCount": {"@type": "xsd:integer"},
    "mowm:parentWorld": {"@type": "@id"},
    "mowm:tau": {"@type": "@id"},
    "mowm:mergeStrategy": {"@type": "@id"},
    "mowm:queryVector": {"@type": "@id"},
    "mowm:bestWorld": {"@type": "@id"},
    "mowm:runnerUpWorld": {"@type": "@id"},
    "mowm:routedTo": {"@type": "@id"},
    "mowm:floorThreshold": {"@type": "@id"},
    "mowm:marginThreshold": {"@type": "@id"},
    "mowm:residual": {"@type": "@id"},
    "mowm:bestScore": {"@type": "xsd:decimal"},
    "mowm:runnerUpScore": {"@type": "xsd:decimal"},
    "mowm:margin": {"@type": "xsd:decimal"},

    "prov:used": {"@type": "@id"},
    "prov:generated": {"@type": "@id"},
    "prov:wasGeneratedBy": {"@type": "@id"},
    "prov:wasInformedBy": {"@type": "@id"},
    "prov:wasAssociatedWith": {"@type": "@id"},
    "prov:wasDerivedFrom": {"@type": "@id"},
    "prov:wasRevisionOf": {"@type": "@id"},
    "prov:hadPrimarySource": {"@type": "@id"},
    "prov:invalidated": {"@type": "@id"},
    "prov:agent": {"@type": "@id"},
    "prov:hadRole": {"@type": "@id"},
    "prov:startedAtTime": {"@type": "xsd:dateTime"},
    "prov:endedAtTime": {"@type": "xsd:dateTime"},
    "prov:generatedAtTime": {"@type": "xsd:dateTime"},
    "prov:invalidatedAtTime": {"@type": "xsd:dateTime"},

    "time:hasBeginning": {"@type": "@id"},
    "time:hasEnd": {"@type": "@id"},
    "time:inXSDDateTimeStamp": {"@type": "xsd:dateTimeStamp"},

    "schema:isPartOf": {"@type": "@id"},
    "schema:about": {"@type": "@id"},

    "dcterms:type": {"@type": "@id"}
  }
}
